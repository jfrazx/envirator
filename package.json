{
  "name": "@status/envirator",
  "version": "0.0.0-development",
  "description": "Ensure environment variable availability during program initialization",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "commit": "git-cz",
    "test": "mocha",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsup",
    "coverage:check": "nyc check-coverage",
    "coverage:report": "nyc report --reporter=text-lcov > coverage.lcov",
    "precoverage:test": "rimraf coverage",
    "coverage:test": "nyc mocha",
    "check": "npm outdated",
    "nyc": "nyc",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfrazx/envirator.git"
  },
  "keywords": [
    "env",
    "environment",
    "provide",
    "envar",
    "security"
  ],
  "author": "jfrazx",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jfrazx/envirator/issues"
  },
  "homepage": "https://github.com/jfrazx/envirator#readme",
  "dependencies": {
    "@jfrazx/asarray": "^1.0.1",
    "camelcase": "^6.2.0",
    "dotenv": "^17.2.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/chai": "^4.2.16",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@types/sinon": "^21.0.0",
    "chai": "^6.0.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0",
    "pino": "^10.1.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.2",
    "semantic-release": "^25.0.9",
    "sinon": "^21.0.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "winston": "^3.18.3"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "mocha": {
    "recursive": true,
    "spec": "test/*.spec.ts",
    "reporter": "spec",
    "require": [
      "ts-node/register/transpile-only",
      "source-map-support/register"
    ]
  }
}
