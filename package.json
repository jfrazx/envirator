{
  "name": "@status/envirator",
  "version": "0.0.0-development",
  "description": "Ensure environment variable availability during program initialization",
  "main": "dist/index.js",
  "scripts": {
    "commit": "git-cz",
    "test": "mocha --require ts-node/register test/*.spec.ts",
    "tsc": "tsc",
    "prebuild": "rimraf dist",
    "build": "tsc -d",
    "coverage:check": "nyc check-coverage",
    "coverage:report": "nyc report --reporter=text-lcov > coverage.lcov",
    "coverage:post": "codecov",
    "precoverage:test": "rimraf coverage",
    "coverage:test": "nyc mocha",
    "check": "npm-check -u",
    "nyc": "nyc",
    "precommit": "npm run coverage:test && npm run coverage:check",
    "prepush": "npm run coverage:test",
    "prepublish": "npm run build",
    "publish": "npx semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jfrazx/envirator.git"
  },
  "keywords": [
    "env",
    "environment",
    "provide",
    "envar",
    "security"
  ],
  "author": "jfrazx",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jfrazx/envirator/issues"
  },
  "homepage": "https://github.com/jfrazx/envirator#readme",
  "dependencies": {
    "@jfrazx/asarray": "^1.0.1",
    "camelcase": "^6.2.0",
    "chalk": "^4.1.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/chai": "^4.2.16",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@types/sinon": "^21.0.0",
    "chai": "^4.3.4",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "mocha": "^11.7.5",
    "npm-check": "^6.0.1",
    "nyc": "^17.1.0",
    "pino": "^10.1.0",
    "rimraf": "^6.1.2",
    "sinon": "^21.0.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "typescript": "^5.9.3",
    "winston": "^3.18.3"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "mocha": {
    "recursive": true,
    "spec": "test/*.spec.ts",
    "reporter": "spec",
    "require": [
      "ts-node/register/transpile-only",
      "source-map-support/register"
    ]
  }
}
